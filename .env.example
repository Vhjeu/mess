PORT=5000
NODE_ENV=production
JWT_SECRET=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=messenger

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_VERIFY_ON_START=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_POOL_MAX_CONNECTIONS=3
SMTP_POOL_MAX_MESSAGES=100

# Nếu Railway đang ở Free/Trial/Hobby, dùng Resend HTTPS thay cho SMTP.
# Khi đủ hai biến này, backend tự ưu tiên Resend và không mở kết nối SMTP.
RESEND_API_KEY=
EMAIL_FROM=Nhắn Tin <no-reply@your-domain.example>

# Có thể nhập nhiều origin, phân tách bằng dấu phẩy.
FRONTEND_URL=https://your-app.vercel.app
# Tùy chọn: thêm domain frontend khác ngoài FRONTEND_URL.
CORS_ORIGINS=

EMAIL_TOKEN_SECRET=

VITE_API_URL=
VITE_SOCKET_URL=
